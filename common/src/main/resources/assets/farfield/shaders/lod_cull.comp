#version 460 core

// Occlusion culling of LOD draw commands (LodRenderer), in two phases:
// phase 0 picks the opaque commands of sections visible last frame, which
// the depth pre-pass draws first; phase 1 tests every command's section
// against the depth pyramid built from that depth, marks the visible
// sections and appends their commands to the lists the other passes draw.
// Only depth already drawn this frame hides anything, so no section
// appears a frame late.

layout(local_size_x = 64) in;

struct Command {
    uint count;
    uint instanceCount;
    uint first;
    uint baseInstance; // the section slot
};

struct Section {
    ivec4 originLevel; // origin in blocks (xyz), level (w)
    uvec4 info;        // w: the voxels its quads cover, min xyz then max xyz, 5 bits each (Quad.bounds)
};

// The CPU's lists, in order: solid opaque, discarding opaque, translucent.
layout(std430, binding = 0) readonly buffer Input {
    Command commands[];
};

// Regions of u_capacity commands each, see the R_ constants.
layout(std430, binding = 1) writeonly buffer Output {
    Command culled[];
};

// One count per region, read by glMultiDrawArraysIndirectCount.
layout(std430, binding = 2) buffer Counts {
    uint counts[];
};

layout(std430, binding = 3) readonly buffer Sections {
    Section sections[];
};

// Per slot, the last frame it was found visible: last frame's and this one's.
layout(std430, binding = 4) readonly buffer Previous {
    uint previous[];
};

layout(std430, binding = 5) writeonly buffer Current {
    uint current[];
};

const uint R_FIRST_SOLID = 0u;
const uint R_FIRST_DISCARD = 1u;
const uint R_SECOND_SOLID = 2u;
const uint R_SECOND_DISCARD = 3u;
const uint R_OPAQUE = 4u;
const uint R_TRANSLUCENT = 5u;

uniform uint u_phase;
uniform uint u_frame;
uniform uint u_solid;       // commands in each input list
uniform uint u_discard;
uniform uint u_translucent;
uniform uint u_capacity;    // commands per output region
uniform mat4 u_viewProj;
uniform ivec3 u_cameraBlock;
uniform vec3 u_cameraFrac;
uniform vec2 u_depthRange;  // near, far of the LOD depth mapping (lod.vert)
uniform sampler2D u_hiz;
uniform int u_hizLevels;

void append(uint region, Command c) {
    uint n = atomicAdd(counts[region], 1u);
    culled[region * u_capacity + n] = c;
}

// Whether the box of a section's quads may show in front of the depth
// pyramid. The section's whole box would reach into the sky over every
// ridge (a level-3 section is 256 blocks tall) and never hide.
bool visible(uint slot) {
    Section s = sections[slot];
    float voxel = float(1 << s.originLevel.w);
    uint bounds = s.info.w;
    vec3 boundsMin = vec3(uvec3(bounds, bounds >> 5, bounds >> 10) & 31u);
    vec3 boundsMax = vec3(uvec3(bounds >> 15, bounds >> 20, bounds >> 25) & 31u) + 1.0;
    vec3 lo = vec3(s.originLevel.xyz - u_cameraBlock) - u_cameraFrac + boundsMin * voxel;
    vec3 size = (boundsMax - boundsMin) * voxel;
    float n = u_depthRange.x;
    float f = u_depthRange.y;
    vec2 ndcMin = vec2(1.0);
    vec2 ndcMax = vec2(-1.0);
    float nearest = 1.0;
    for (int c = 0; c < 8; c++) {
        vec3 corner = lo + vec3(c & 1, (c >> 1) & 1, (c >> 2) & 1) * size;
        vec4 clip = u_viewProj * vec4(corner, 1.0);
        if (clip.w < n) {
            return true; // reaches the near plane: no screen rectangle to test
        }
        // lod.vert's depth mapping, then the window depth in [0, 1].
        float z = (f + n) / (f - n) - 2.0 * f * n / ((f - n) * clip.w);
        nearest = min(nearest, z * 0.5 + 0.5);
        vec2 ndc = clip.xy / clip.w;
        ndcMin = min(ndcMin, ndc);
        ndcMax = max(ndcMax, ndc);
    }
    vec2 size0 = vec2(textureSize(u_hiz, 0));
    vec2 r0 = clamp(ndcMin * 0.5 + 0.5, 0.0, 1.0) * size0;
    vec2 r1 = clamp(ndcMax * 0.5 + 0.5, 0.0, 1.0) * size0;
    // The level where the rectangle spans at most 2 x 2 texels.
    float extent = max(r1.x - r0.x, r1.y - r0.y);
    int level = clamp(int(ceil(log2(max(extent, 1.0)))), 0, u_hizLevels - 1);
    ivec2 levelSize = textureSize(u_hiz, level);
    vec2 scale = vec2(levelSize) / size0;
    ivec2 a = clamp(ivec2(r0 * scale), ivec2(0), levelSize - 1);
    ivec2 b = clamp(ivec2(r1 * scale), ivec2(0), levelSize - 1);
    float far = max(max(texelFetch(u_hiz, a, level).r, texelFetch(u_hiz, ivec2(b.x, a.y), level).r),
                    max(texelFetch(u_hiz, ivec2(a.x, b.y), level).r, texelFetch(u_hiz, b, level).r));
    return nearest <= far;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint opaque = u_solid + u_discard;
    if (i >= opaque + u_translucent) {
        return;
    }
    Command c = commands[i];
    uint slot = c.baseInstance;
    bool drawnFirst = previous[slot] == u_frame - 1u;
    if (u_phase == 0u) {
        if (i < opaque && drawnFirst) {
            append(i < u_solid ? R_FIRST_SOLID : R_FIRST_DISCARD, c);
        }
        return;
    }
    if (!visible(slot)) {
        return;
    }
    current[slot] = u_frame;
    if (i < opaque) {
        append(R_OPAQUE, c);
        if (!drawnFirst) {
            append(i < u_solid ? R_SECOND_SOLID : R_SECOND_DISCARD, c);
        }
    } else {
        append(R_TRANSLUCENT, c);
    }
}
